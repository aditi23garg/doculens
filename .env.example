# ── LLM (answer generation) ───────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings (Google AI Studio) ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key
EMBEDDING_MODEL=gemini-embedding-001
# Do NOT set this to gemini-embedding-2 or gemini-embedding-2-preview: those models have a
# known bug (googleapis/python-genai#2523) where embed_content() with a list of texts
# silently returns only ONE embedding back regardless of how many were sent, with no error.
# In this app that one embedding pairs with the overview chunk (always first in the list),
# and every other chunk in the document is silently never stored - the document still shows
# as "ready", it just has nothing but its own table of contents in it.
# gemini-embedding-001 does not have this bug and is what this project is built against.
EMBEDDING_DIM=768

# ── MongoDB Atlas (users, chats, document metadata) ───────────────────────────
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=doculens

# ── Qdrant Cloud (document vectors) ───────────────────────────────────────────
QDRANT_URL=your_qdrant_cluster_url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=doculens_chunks

# ── Grounding / retrieval ─────────────────────────────────────────────────────
# Off-topic gate. If the best match for the user's question reaches MIN_RELEVANCE_SCORE
# it passes. Up to 0.10 below it, it still passes when the question's key terms appear in
# the retrieved passages. Anything lower is refused WITHOUT calling the LLM. The answer
# prompt is the real backstop, so this is deliberately lenient. Lower it if valid
# questions are refused; raise it if off-topic questions reach the model. Typical: 0.35 - 0.55.
MIN_RELEVANCE_SCORE=0.40
# Show a "Search details" panel under answers (queries, gate decision, scores).
# Handy while tuning; set to false for end users.
SHOW_SEARCH_DETAILS=true
# After the gate passes, every passage within RELEVANCE_MARGIN of the best score is
# sent to the LLM (up to MAX_CONTEXT_CHUNKS). Raise the margin for broader answers.
RELEVANCE_MARGIN=0.18
RETRIEVAL_TOP_K=8
MAX_CONTEXT_CHUNKS=10
# A rich section split across several chunks: once any one chunk of it is kept, pull in
# the rest of that section too, up to this many extra chunks.
SECTION_COMPLETE_EXTRA_CHUNKS=6
# Safety net for questions about one specific term (a model name, a number, jargon): a
# chunk that literally contains a distinctive term of the question is included even if its
# embedding score alone would have excluded it, up to this many extra chunks.
LEXICAL_RESCUE_EXTRA_CHUNKS=3
# One extra small LLM call per question that writes alternative search phrasings.
# Set to false to save Groq quota (follow-up rewriting still happens).
QUERY_EXPANSION=true

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Semantic chunking: a heading's section stays in one chunk up to CHUNK_MAX_CHARS;
# longer sections are split where the meaning shifts. Small neighbours merge up to that size.
CHUNK_MAX_CHARS=1200
CHUNK_MIN_CHARS=250
SEMANTIC_BREAKPOINT_PERCENTILE=85
MAX_UPLOAD_MB=20
